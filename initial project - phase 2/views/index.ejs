<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Qahwa Café - Home</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Poppins:wght@300;400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <%- include('partials/navbar') %>

    <div id="hamburger-container" style="position: relative; display: none">
      <button
        id="hamburger-btn"
        style="background: none; border: none; cursor: pointer; font-size: 24px"
      >
        ☰
      </button>

      <div
        id="hamburger-menu"
        class="hidden"
        style="
          position: absolute;
          right: 0;
          top: 40px;
          background: white;
          border: 1px solid #ccc;
          padding: 10px;
          border-radius: 5px;
        "
      >
        <a href="/settings" style="display: block; padding: 5px 10px"
          >Settings</a
        >
        <a href="/history" style="display: block; padding: 5px 10px">History</a>
        <a
          href="/logout"
          id="logout-link"
          style="display: block; padding: 5px 10px"
          >Logout</a
        >
      </div>
    </div>

    <section class="home">
      <video
        autoplay
        muted
        loop
        playsinline
        class="bg-video"
        style="
          position: absolute;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          object-fit: cover;
          z-index: -1;
        "
      >
        <source src="/uploads/coffee-background.mp4" type="video/mp4" />
        Your browser does not support HTML5 video.
      </video>

      <div class="content">
        <h3>Where Taste Meets Soul</h3>
        <p>Savor the bold aroma and warm elegance of your perfect cup.</p>

        <div class="button-group">
          <a href="/menu" class="btn">Explore Menu</a>
          <a
            href="/uploads/coffee-process-animation.mp4"
            target="_blank"
            class="btn"
            >Coffee Process Animation</a
          >
          <% if (!user) { %>
          <a href="/signup" class="btn">Sign Up</a>
          <% } %>
        </div>
      </div>
    </section>

    <%- include('partials/footer') %>

    <script src="/js/auth.js"></script>
  </body>
</html>
