<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Sign Up - Qahwa Café</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="../public/css/style.css" />
  <script defer src="../public/js/main.js"></script>
</head>
<body>

  <!-- <header class="header">
    <div class="logo">Qahwa Café</div>
    
  </header> -->
<%- include('partials/navbar') %>

  <section class="contact">
    <h1 class="heading" id="signupTitle">Welcome Guest</h1>

    <form method="post" id="signupForm">
      <input type="text" id="firstName" placeholder="First Name" required />
      <div id="lastNameContainer">
        <input type="text" id="lastName" placeholder="Last Name" required/>
      </div>

      <select id="gender" required>
        <option value="">Select Gender</option>
        <option value="Male">Male</option>
        <option value="Female">Female</option>
      </select>

      <input type="email" id="email" placeholder="Email" required />

      <input type="password" id="password" placeholder="Password" required />
      <small>Password must be at least 8 characters and include uppercase, lowercase, number, and symbol.</small>

      <div>
        <input type="text" value="002" disabled style="width: 60px;" />
        <input type="text" id="mobile" placeholder="Mobile Number" maxlength="11" style="width: calc(100% - 70px);" required />
      </div>

      <div id="errorMessages" style="color: red; font-size: 0.9rem;"></div>

      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
  <button type="submit" class="btn">Sign Up</button>
  <button type="reset" class="btn">Reset</button>
  <button type="button" class="btn" id="hideLastNameBtn">Hide Last Name</button>
  <button type="button" class="btn" id="loggedInBtn" disabled>Logged In</button>
</div>


    </form>
  </section>

  <!-- <footer class="footer">
    <p>&copy; 2025 Qahwa Café — Brewed with Passion in Cairo</p>
  </footer> -->
  <%- include('partials/footer') %>

</body>
</html>
