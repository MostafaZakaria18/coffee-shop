<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Qahwa Café - Menu</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700&family=Poppins:wght@300;400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>

<body>
  <%- include('partials/navbar') %>

  <section class="menu" id="menu">
    <h1 class="heading">Our <span>Coffee</span> Menu</h1>

    <div class="box-container">
      <% menuItems.forEach(item => { %>
        <div class="box">
          <img src="<%= item.image %>" alt="<%= item.name %>">
          <h3><%= item.name %></h3>
          <div class="price">$<%= item.price.toFixed(2) %></div>
          <% if (userLoggedIn) { %>
            <div class="menu-actions">
              <button class="minus-cart" data-name="<%= item.name %>">-</button>
              <span class="item-qty" id="qty-<%= item.name.replace(/\s+/g, '-') %>">0</span>
              <button class="add-to-cart" data-name="<%= item.name %>" data-price="<%= item.price %>">+</button>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>
  </section>
  <%- include('partials/footer') %>
  <script src="/js/cart.js"></script>
  <div id="toast" class="toast">Item added to cart</div>
</body>
</html>
